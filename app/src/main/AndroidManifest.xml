<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 출석 등 온라인 전용 기능의 연결 확인 (NetworkMonitor, #531) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- 광고 ID 관련 권한 제거 (#785). firebase-analytics(play-services-measurement-*)가 넣는 권한을 병합 매니페스트에서 뺀다.
         광고가 없어 쓰지 않고, Play 가족 정책상 나이를 모르는 사용자의 광고 ID를 보내면 안 된다.
         AD_ID: Google Play 서비스 광고 ID / ACCESS_ADSERVICES_AD_ID: Privacy Sandbox 광고 ID API / ACCESS_ADSERVICES_ATTRIBUTION: Privacy Sandbox 광고 기여 분석 API -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove"/>

    <application
        android:name=".PlantApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Plant">
        <!-- Crashlytics 수집 여부: 기본 false, release만 true (app/build.gradle.kts defaultConfig·release, #622) -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${crashlyticsCollectionEnabled}" />
        <!-- Analytics 광고 ID 수집 끄기 (#785). 앱 인스턴스 ID·이벤트 수집은 그대로. 빌드 타입 구분 없이 항상 false -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Plant.Splash"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            >
<!--            edge-to-edge + imePadding 조합에서 시스템 adjustPan이 겹쳐 키보드 위 빈 공간/버벅임이 생기므로 adjustResize로 키보드 처리를 Compose에 위임-->

<!--            세로 고정용 screenOrientation-->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".presentation.studying.service.StudyingTimerService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated study stopwatch that keeps counting elapsed time and shows it in an ongoing notification while the timer is running" />
        </service>
    </application>

</manifest>
