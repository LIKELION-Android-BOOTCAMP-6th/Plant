<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Plant" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 스플래시 테마 (Android 8~11: 배경색 + 정적 로고). Android 12+는 values-v31/themes.xml -->
    <style name="Theme.Plant.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Plant</item>
        <!-- 배경이 늘 밝으므로 상태바·내비게이션바 아이콘을 어둡게 (내비게이션바는 Android 8.1+, #675) -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
