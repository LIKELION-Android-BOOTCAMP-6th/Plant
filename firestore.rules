rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // 예전 문서에는 집계 필드가 없을 수 있어 기본값으로 비교한다
    function oldValue(field, defaultValue) {
      return resource.data.get(field, defaultValue);
    }

    function newValue(field, defaultValue) {
      return request.resource.data.get(field, defaultValue);
    }

    // 카운트 필드 하나만 delta만큼 바뀌는 쓰기 (FieldValue.increment)
    function onlyCountChangedBy(field, delta) {
      return changedKeys().hasOnly([field]) &&
        newValue(field, 0) == oldValue(field, 0) + delta;
    }

    // 배열에 본인 uid 1개 추가 + 카운트 +1, 또는 본인 uid 제거 + 카운트 -1 (arrayUnion/arrayRemove + increment)
    function selfToggled(arrayField, countField) {
      let uid = request.auth.uid;
      let before = oldValue(arrayField, []);
      let after = newValue(arrayField, []);
      let added = !(uid in before) &&
        after.size() == before.size() + 1 &&
        after.toSet() == before.toSet().union([uid].toSet()) &&
        newValue(countField, 0) == oldValue(countField, 0) + 1;
      let removed = (uid in before) &&
        !(uid in after) &&
        after.toSet() == before.toSet().difference([uid].toSet()) &&
        newValue(countField, 0) == oldValue(countField, 0) - 1;
      return changedKeys().hasOnly([arrayField, countField]) && (added || removed);
    }

    function selfRemoved(arrayField) {
      return !(request.auth.uid in newValue(arrayField, []));
    }

    // 신고 1건당 reportCount +1: 같은 쓰기(batch)에서 reports/{내uid_대상id} 문서가 새로 생겨야 한다
    // (신고 문서 없이 +1만 반복해 블라인드시키는 것을 막음)
    function reportCreatedInSameWrite(targetId) {
      let reportPath = /databases/$(database)/documents/reports/$(request.auth.uid + '_' + targetId);
      return !exists(reportPath) && existsAfter(reportPath);
    }

    // 생성 시 신고/숨김 상태는 초기값이어야 한다
    function hasInitialModeration() {
      return newValue('reportCount', 0) == 0 && newValue('isHidden', false) == false;
    }

    // 닉네임 형식 검사 (#535) — 앱의 NicknameRule.normalize·isUsable과 같은 기준 중 정규식으로 막을 수 있는 범위
    // 앱이 허용하는 닉네임을 규칙이 거부하면 안 되므로, 앱보다 엄격하게 만들지 않는다.
    // - 앞뒤 공백: 앱은 normalize에서 trim하므로 공백이 남아 있으면 앱을 거치지 않은 값
    // - 연속 공백: "새  싹"이 "새 싹"처럼 보임
    // - 일반 공백(U+0020) 외 공백 문자(\p{Z}: U+00A0, U+3000 등), 제어 문자(\p{Cc}), 서식 문자(\p{Cf}), 사용자 정의 영역 문자(\p{Co})
    //   (서로게이트는 Firestore 문자열(UTF-8)에 들어올 수 없어 따로 검사하지 않음)
    // - 점자 공백(U+2800), 기본적으로 화면에 표시하지 않는 문자(Default_Ignorable_Code_Point: 한글 채움 문자 등)
    // - 분리형 한글 자모(U+1100–11FF, U+A960–A97F, U+D7B0–D7FF): 규칙은 NFC 정규화를 할 수 없어 범위로 막는다
    //   (앱은 NFC로 완성형으로 합친 뒤 저장하므로 정상 입력은 영향 없음. 키보드 자모 U+3131–318E는 막지 않음)
    // 이모지에 쓰이는 결합 문자(ZWJ, U+200D)·모양 선택 문자(U+FE00–FE0F, U+E0100–E01EF)는 막지 않는다.
    // 이모지 사이에 있는지 같은 위치 판단은 앱(NicknameRule.hasLookAlikeChar)에 맡긴다.
    // (ZWJ는 서식 문자(\p{Cf})라서 검사 전에 지우고, 일반 공백도 \p{Z}에 걸리지 않게 지운 뒤 검사한다)
    function isValidNickname(nickname) {
      let rest = nickname.replace('[ \\x{200D}]', '');
      return nickname is string &&
        nickname.size() > 0 &&
        nickname.trim() == nickname &&
        !nickname.matches('(?s).*  .*') &&
        !rest.matches('(?s).*[' +
          '\\p{Z}\\p{Cc}\\p{Cf}\\p{Co}\\x{2800}' +
          '\\x{00AD}\\x{034F}\\x{061C}\\x{115F}-\\x{1160}\\x{17B4}-\\x{17B5}' +
          '\\x{180B}-\\x{180F}\\x{200B}-\\x{200C}\\x{200E}-\\x{200F}\\x{202A}-\\x{202E}\\x{2060}-\\x{206F}\\x{3164}' +
          '\\x{FEFF}\\x{FFA0}\\x{FFF0}-\\x{FFF8}\\x{1BCA0}-\\x{1BCA3}' +
          '\\x{1D173}-\\x{1D17A}\\x{E0000}-\\x{E00FF}\\x{E01F0}-\\x{E0FFF}' +
          '\\x{1100}-\\x{11FF}\\x{A960}-\\x{A97F}\\x{D7B0}-\\x{D7FF}' +
          '].*');
    }

    // 닉네임 필드를 바꾸는 쓰기는 그 닉네임의 nicknames 문서를 본인이 가지고 있어야 한다 (#535)
    // getAfter: 첫 로그인(completeFirstLogin)은 nicknames 생성과 users 수정을 한 트랜잭션에서 하므로
    //           쓰기 전 상태(get)로는 아직 문서가 없어 거부된다
    // 문서가 없거나 경로로 쓸 수 없는 값('/' 포함, 빈 문자열 등)이면 오류 → 거부
    function ownsNicknameAfterWrite(nickname) {
      return nickname is string &&
        nickname.size() > 0 &&
        getAfter(/databases/$(database)/documents/nicknames/$(nickname)).data.get('uid', '') == request.auth.uid;
    }

    // 닉네임 문서를 지운 뒤에도 내 users.nickname이 그 닉네임이면 다른 사람이 같은 닉네임을 등록할 수 있다 (#549)
    // 그래서 쓰기 후 내 users 문서가 없거나, users.nickname이 그 닉네임이 아닐 때만 지울 수 있다
    // getAfter: 닉네임 변경(updateProfile)은 이전 닉네임 삭제와 users.nickname 변경을 한 트랜잭션에서 하므로
    //           쓰기 전 상태(get)로는 아직 이전 닉네임이라 거부된다
    // existsAfter와 getAfter는 같은 문서라 읽기 비용은 1회
    function nicknameReleasedAfterWrite(nickname) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return !existsAfter(userPath) || getAfter(userPath).data.get('nickname', '') != nickname;
    }

    // ---------------------------------------------------------------------
    // 학습 기록 저장 검증 (#453)
    // ---------------------------------------------------------------------
    // 학습 종료(또는 복구) 시 앱은 아래 3개를 batch 하나로 쓴다. 오프라인이면 기기 캐시에 먼저 반영되고 연결되면 전송된다.
    //   1. users/{uid}/pots/{potId}/logs/{sessionId} 생성 (rewardStatus: 'pending', rewardSeen: false)
    //   2. pots/{potId}: potTotalStudyingTime += 학습 시간, lastStudiedAt = 서버 시각, lastStudySessionId = sessionId
    //   3. users/{uid}: totalStudyTime += 학습 시간, lastStudyEndedAt = startedAt + 학습 시간,
    //                   lastStudyPotId = potId, lastStudySessionId = sessionId
    // 세 문서의 규칙이 서로를 확인하므로 하나라도 빠지거나 값이 맞지 않으면 batch 전체가 거부된다.
    // - 같은 세션이 두 번 오면(대기열의 batch + 복구 재전송) 기록이 이미 있어 거부 → 학습 시간이 한 번만 늘어난다
    // - 보상(item.*, reward)은 쓰지 않는다. 기록이 서버에 생기면 grantStudyReward 트리거가 지급한다
    // - "시작 24시간 이내" 검증은 두지 않는다: 오프라인으로 며칠 지나 동기화한 정상 기록이 거부되기 때문
    // 학습 시간을 줄이는 쓰기(기록 삭제, 화분 삭제)는 아래 #455 검증으로만 허용한다

    // 세션 하나의 최대 학습 시간 (24시간, ms)
    function maxStudyingTimeMs() {
      return 24 * 60 * 60 * 1000;
    }

    // 기기 시계가 서버보다 빠를 때 허용하는 오차: 종료 시각(startedAt + 학습 시간)이 서버 시각보다 이만큼까지 늦어도 통과
    // 오프라인 쓰기는 늦게 도착할 뿐 미래가 되지 않으므로 정상 사용자는 오차 없이도 통과한다
    function clockSkewTolerance() {
      return duration.value(5, 'm');
    }

    // 앱의 학습 목표 최대 개수(StudyingConstants.MAX_STUDY_LOG_SIZE)와 목표 한 개 최대 길이(StudyingGoalInputDialog maxLength)
    function maxStudyGoalCount() {
      return 10;
    }

    function maxStudyGoalLength() {
      return 100;
    }

    function studyLogPath(userId, potId, logId) {
      return /databases/$(database)/documents/users/$(userId)/pots/$(potId)/logs/$(logId);
    }

    // 이 쓰기에서 처음 생기는 학습 기록인지 (이미 있으면 같은 세션의 재전송)
    function studyLogCreatedInThisWrite(userId, potId, logId) {
      let path = studyLogPath(userId, potId, logId);
      return !exists(path) && existsAfter(path);
    }

    // 규칙은 반복문이 없어 목표 개수(최대 10개)만큼 칸을 하나씩 확인한다
    function goalFits(contents, completed, i) {
      return contents.size() <= i ||
        (contents[i] is string && contents[i].size() <= maxStudyGoalLength() && completed[i] is bool);
    }

    function goalsFit(contents, completed) {
      return contents is list &&
        completed is list &&
        contents.size() <= maxStudyGoalCount() &&
        completed.size() == contents.size() &&
        goalFits(contents, completed, 0) && goalFits(contents, completed, 1) &&
        goalFits(contents, completed, 2) && goalFits(contents, completed, 3) &&
        goalFits(contents, completed, 4) && goalFits(contents, completed, 5) &&
        goalFits(contents, completed, 6) && goalFits(contents, completed, 7) &&
        goalFits(contents, completed, 8) && goalFits(contents, completed, 9);
    }

    // logs/{logId} 생성: 기록 내용 검증 + 같은 쓰기에서 화분·유저가 이 기록으로 갱신되는지 확인
    // (화분·유저 쪽 시간 누적량은 각 문서의 규칙(potStudySaved, userStudySaved)이 검증한다)
    function isValidNewStudyLog(userId, potId, logId) {
      let data = request.resource.data;
      let userPath = /databases/$(database)/documents/users/$(userId);
      let potPath = /databases/$(database)/documents/users/$(userId)/pots/$(potId);
      let fields = ['uid', 'title', 'contents', 'completedContents', 'studyingTime', 'createAt', 'startedAt', 'rewardStatus', 'rewardSeen'];
      return data.keys().hasOnly(fields) &&
        data.keys().hasAll(fields) &&
        data.uid == userId &&
        data.title is string &&
        data.title.size() <= 100 &&
        goalsFit(data.contents, data.completedContents) &&
        data.studyingTime is int &&
        data.studyingTime > 0 &&
        data.studyingTime <= maxStudyingTimeMs() &&
        data.createAt is timestamp &&
        data.startedAt is timestamp &&
        data.startedAt + duration.value(data.studyingTime, 'ms') <= request.time + clockSkewTolerance() &&
        // 보상은 트리거만 쓴다: 앱은 대기 상태로만 만든다 ('reward' 필드는 위 hasOnly에서 막힘)
        data.rewardStatus == 'pending' &&
        data.rewardSeen == false &&
        // 화분이 없으면 get이 실패해 거부된다 (없는 화분)
        get(potPath).data.get('lastStudySessionId', '') != logId &&
        getAfter(potPath).data.get('lastStudySessionId', '') == logId &&
        getAfter(userPath).data.get('lastStudySessionId', '') == logId &&
        getAfter(userPath).data.get('lastStudyPotId', '') == potId;
    }

    // logs/{logId} 수정: 앱은 보상 확인 표시(rewardSeen = true)만 바꿀 수 있다
    function onlyRewardSeenMarked() {
      return changedKeys().hasOnly(['rewardSeen']) && request.resource.data.rewardSeen == true;
    }

    // pots/{potId} 수정 중 학습 저장: 같은 쓰기에서 생긴 기록의 학습 시간만큼만 늘어나고, 완료된 화분이 아니어야 한다
    function potStudySaved(userId, potId) {
      let sessionId = request.resource.data.get('lastStudySessionId', '');
      return changedKeys().hasOnly(['potTotalStudyingTime', 'lastStudiedAt', 'lastStudySessionId']) &&
        sessionId is string &&
        sessionId != '' &&
        oldValue('isCompleted', false) == false &&
        studyLogCreatedInThisWrite(userId, potId, sessionId) &&
        newValue('potTotalStudyingTime', 0) == oldValue('potTotalStudyingTime', 0) +
          getAfter(studyLogPath(userId, potId, sessionId)).data.studyingTime &&
        request.resource.data.lastStudiedAt == request.time;
    }


    // users/{uid} 수정 중 학습 저장: 같은 쓰기에서 생긴 기록의 학습 시간만큼만 늘어나고, 이전 세션과 겹치지 않아야 한다
    // 겹침 판단은 startedAt + 학습 시간(일시정지 시간 제외) 기준이라 실제 종료보다 이르므로 다음 세션에 불리하지 않다
    function userStudySaved(userId) {
      let data = request.resource.data;
      let sessionId = data.get('lastStudySessionId', '');
      let potId = data.get('lastStudyPotId', '');
      let log = getAfter(studyLogPath(userId, potId, sessionId)).data;
      return changedKeys().hasOnly(['totalStudyTime', 'lastStudyEndedAt', 'lastStudyPotId', 'lastStudySessionId']) &&
        sessionId is string &&
        sessionId != '' &&
        potId is string &&
        potId != '' &&
        studyLogCreatedInThisWrite(userId, potId, sessionId) &&
        newValue('totalStudyTime', 0) == oldValue('totalStudyTime', 0) + log.studyingTime &&
        log.startedAt >= oldValue('lastStudyEndedAt', timestamp.value(0)) &&
        data.lastStudyEndedAt == log.startedAt + duration.value(log.studyingTime, 'ms');
    }

    // ---------------------------------------------------------------------
    // 화분 완료, 학습 기록 삭제, 화분 삭제 검증 (#455)
    // ---------------------------------------------------------------------
    // 세 작업 모두 앱이 batch 하나로 쓰고, 오프라인이면 기기 캐시에 먼저 반영된 뒤 연결되면 전송된다.
    // 바뀌는 값(완료 수 +1, 학습 시간 차감량)은 앱이 정한 값이 아니라 쓰기 전 저장된 값(get)과 같을 때만 허용한다.
    // 규칙은 같은 batch의 다른 쓰기를 직접 볼 수 없으므로, 어떤 화분·기록을 처리했는지 표시 필드에 함께 적는다
    // (#453의 lastStudySessionId와 같은 방식)
    //   - 화분 완료:   pots.isCompleted = true, pots.completedAt = 서버 시각
    //                  users.completedPotsCount += 1, users.lastCompletedPotId = potId
    //   - 기록 삭제:   logs/{logId} 삭제
    //                  pots.potTotalStudyingTime -= 기록의 studyingTime, pots.lastDeletedLogId = logId
    //                  users.totalStudyTime -= 기록의 studyingTime, users.lastDeletedPotId = potId, users.lastDeletedLogId = logId
    //   - 화분 삭제:   pots/{potId} 삭제
    //                  users.totalStudyTime -= 화분의 potTotalStudyingTime, users.lastDeletedPotId = potId, users.lastDeletedLogId = ''
    //                  (완료된 화분이면 users.completedPotsCount -= 1 도 함께)
    //                  하위 logs는 onPotDeleted 트리거(functions/index.js)가 지운다
    // 같은 작업이 두 번 도착하면(연타, 재전송) 두 번째는 이미 완료·삭제된 상태라 거부된다 → 카운트·시간은 1번만 바뀐다
    // 차감 결과가 0 이상인지는 확인하지 않는다: 예전 데이터가 어긋나 음수가 되더라도 삭제는 되게 한다
    // 이미 받은 보상은 회수하지 않는다 (item.* 는 건드리지 않음)

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function potPath(userId, potId) {
      return /databases/$(database)/documents/users/$(userId)/pots/$(potId);
    }

    // 이 쓰기에서 지워지는 문서인지 (이미 없으면 같은 삭제의 재전송)
    function deletedInThisWrite(path) {
      return exists(path) && !existsAfter(path);
    }

    function isNonEmptyString(value) {
      return value is string && value != '';
    }

    // pots/{potId} 수정 중 기록 삭제: 같은 쓰기에서 지워지는 기록의 저장된 학습 시간만큼만 줄어든다
    function potStudyLogDeleted(userId, potId) {
      let logId = newValue('lastDeletedLogId', '');
      let path = studyLogPath(userId, potId, logId);
      return changedKeys().hasOnly(['potTotalStudyingTime', 'lastDeletedLogId']) &&
        isNonEmptyString(logId) &&
        deletedInThisWrite(path) &&
        newValue('potTotalStudyingTime', 0) == oldValue('potTotalStudyingTime', 0) - get(path).data.get('studyingTime', 0);
    }

    // pots/{potId} 수정 중 완료: 미완료 → 완료로만 바뀌고, 같은 쓰기에서 users의 완료 수가 이 화분으로 올라가야 한다
    // (완료 수 +1 검증은 users 규칙(userPotCompleted)이 한다)
    function potCompleted(userId, potId) {
      return changedKeys().hasOnly(['isCompleted', 'completedAt']) &&
        oldValue('isCompleted', false) == false &&
        request.resource.data.isCompleted == true &&
        request.resource.data.completedAt == request.time &&
        get(userPath(userId)).data.get('lastCompletedPotId', '') != potId &&
        getAfter(userPath(userId)).data.get('lastCompletedPotId', '') == potId;
    }

    // pots/{potId} 수정 중 위 검증이 없는 쓰기(이름 변경 등): 학습 시간·학습 저장·완료·삭제 표시 필드와 레벨은 바꿀 수 없다
    // 레벨은 레벨업 검증(potLeveledUp, #456)으로만 바꿀 수 있다
    function potCountedFieldsKept() {
      return !changedKeys().hasAny([
        'potTotalStudyingTime', 'lastStudiedAt', 'lastStudySessionId',
        'lastDeletedLogId', 'isCompleted', 'completedAt', 'potLevel'
      ]);
    }

    // users/{uid} 수정 중 기록 삭제: 같은 쓰기에서 지워지는 기록의 저장된 학습 시간만큼만 줄어든다
    function userStudyLogDeleted(userId) {
      let potId = newValue('lastDeletedPotId', '');
      let logId = newValue('lastDeletedLogId', '');
      let path = studyLogPath(userId, potId, logId);
      return changedKeys().hasOnly(['totalStudyTime', 'lastDeletedPotId', 'lastDeletedLogId']) &&
        isNonEmptyString(potId) &&
        isNonEmptyString(logId) &&
        deletedInThisWrite(path) &&
        newValue('totalStudyTime', 0) == oldValue('totalStudyTime', 0) - get(path).data.get('studyingTime', 0);
    }

    // users/{uid} 수정 중 화분 삭제: 같은 쓰기에서 지워지는 화분의 저장된 학습 시간만큼 줄어들고,
    // 완료된 화분이면 완료 수도 1 줄어든다 (미완료 화분이면 완료 수는 그대로)
    function userPotDeleted(userId) {
      let potId = newValue('lastDeletedPotId', '');
      let path = potPath(userId, potId);
      let pot = get(path).data;
      let completedDelta = pot.get('isCompleted', false) == true ? 1 : 0;
      return changedKeys().hasOnly(['totalStudyTime', 'lastDeletedPotId', 'lastDeletedLogId', 'completedPotsCount']) &&
        isNonEmptyString(potId) &&
        newValue('lastDeletedLogId', '') == '' &&
        deletedInThisWrite(path) &&
        newValue('totalStudyTime', 0) == oldValue('totalStudyTime', 0) - pot.get('potTotalStudyingTime', 0) &&
        newValue('completedPotsCount', 0) == oldValue('completedPotsCount', 0) - completedDelta;
    }

    // users/{uid} 수정 중 화분 완료: 같은 쓰기에서 미완료 → 완료로 바뀌는 화분이 있을 때만 완료 수 +1 (정확히 1)
    function userPotCompleted(userId) {
      let potId = newValue('lastCompletedPotId', '');
      let path = potPath(userId, potId);
      return changedKeys().hasOnly(['completedPotsCount', 'lastCompletedPotId']) &&
        isNonEmptyString(potId) &&
        get(path).data.get('isCompleted', false) == false &&
        getAfter(path).data.get('isCompleted', false) == true &&
        newValue('completedPotsCount', 0) == oldValue('completedPotsCount', 0) + 1;
    }

    // users/{uid} 수정 중 위 검증이 없는 쓰기(닉네임, 이미지, 출석, 아이템 등):
    // 학습 시간·학습 저장·완료 수·삭제/완료/레벨업 표시 필드는 바꿀 수 없다
    function userCountedFieldsKept() {
      return !changedKeys().hasAny([
        'totalStudyTime', 'lastStudyEndedAt', 'lastStudyPotId', 'lastStudySessionId',
        'completedPotsCount', 'lastCompletedPotId', 'lastDeletedPotId', 'lastDeletedLogId',
        'lastLevelUpPotId'
      ]);
    }

    // users의 삭제 표시가 이 쓰기에서 (potId, logId)로 바뀌는지 — 쓰기 전에도 같은 값이면 users를 쓰지 않은 것
    // (화분 삭제는 logId = '')
    function userDeletionMarkedInThisWrite(userId, potId, logId) {
      let before = get(userPath(userId)).data;
      let after = getAfter(userPath(userId)).data;
      return !(before.get('lastDeletedPotId', '') == potId && before.get('lastDeletedLogId', '') == logId) &&
        after.get('lastDeletedPotId', '') == potId &&
        after.get('lastDeletedLogId', '') == logId;
    }

    // logs/{logId} 삭제: 같은 쓰기에서 화분·유저의 학습 시간이 이 기록으로 줄어들어야 한다
    // (차감량 검증은 potStudyLogDeleted, userStudyLogDeleted가 한다)
    // 화분이 없으면 get이 실패해 거부된다 → 화분 삭제 후 남은 기록은 트리거가 지운다
    function studyLogDeletedWithTotals(userId, potId, logId) {
      return get(potPath(userId, potId)).data.get('lastDeletedLogId', '') != logId &&
        getAfter(potPath(userId, potId)).data.get('lastDeletedLogId', '') == logId &&
        userDeletionMarkedInThisWrite(userId, potId, logId);
    }

    // pots/{potId} 삭제: 같은 쓰기에서 유저의 학습 시간이 이 화분으로 줄어들어야 한다 (차감량 검증은 userPotDeleted)
    // 이 화분의 기록을 지운 직후라 users 표시가 (potId, logId)여도, 화분 삭제는 logId = ''로 바꾸므로 구분된다
    function potDeletedWithTotals(userId, potId) {
      return userDeletionMarkedInThisWrite(userId, potId, '');
    }

    // ---------------------------------------------------------------------
    // 화분 레벨업 검증 (#456)
    // ---------------------------------------------------------------------
    // 앱은 아래 2개를 batch 하나로 쓴다. 오프라인이면 기기 캐시에 먼저 반영되고 연결되면 전송된다.
    //   - pots/{potId}: potLevel = 현재 레벨 + 1 (증가값이 아닌 정해진 값)
    //   - users/{uid}:  item.* -= 레벨업 조건 표의 필요 개수 (FieldValue.increment), lastLevelUpPotId = potId
    // 두 문서의 규칙이 서로를 확인한다.
    //   - 화분 규칙(potLeveledUp): 같은 쓰기의 유저 아이템 변화(get → getAfter)가 조건 표와 같은지
    //   - 유저 규칙(userLeveledUpPot): 성장 아이템이 줄어드는 쓰기면, 같은 쓰기에서 표시한 화분의 레벨이 1 올라가는지
    // 같은 레벨업이 두 번 도착하면(연타, 재전송) 두 번째의 화분 쓰기는 서버 레벨과 같은 값이라 바뀌는 것이 없다.
    // 화분 쓰기 자체는 통과하지만 유저 규칙이 "레벨이 오르지 않았는데 아이템이 줄어듦"으로 거부한다
    // → 두 단계 연속 상승·이중 차감이 생기지 않는다.
    // 학습 시간 조건은 레벨업 시점에만 확인한다: 나중에 기록을 지워 시간이 조건 아래로 내려가도 오른 레벨은 유지한다
    // 완료된 화분은 레벨업할 수 없다 (홈은 진행 중인 화분만 보여주고, 학습 저장(potStudySaved)도 완료 화분을 거부함)

    // 최고 레벨 — 앱의 PotLevelConditions.table에 조건이 있는 마지막 레벨(5) + 1
    function maxPotLevel() {
      return 6;
    }

    // 레벨업 조건 표: 아래 두 함수의 [현재 레벨] 값이 다음 레벨로 올리는 조건이다
    // 앱 domain/model/LevelUpCondition.kt의 PotLevelConditions.table(minHoursForLevelUp, requiredItems)과 같아야 한다.
    // 값을 바꾸면 두 곳을 함께 수정한다 — rules-test/test/potLevelUp.test.js가 앱 파일을 읽어 레벨마다 경계값을 확인한다
    function levelUpMinStudyMs(level) {
      return [1, 5, 15, 30, 70, 150][level] * 60 * 60 * 1000;
    }

    function levelUpRequiredItems(level) {
      return [
        {'heart': 1},
        {'sun': 3, 'water': 1, 'heart': 5},
        {'water': 5, 'sun': 15, 'heart': 22},
        {'fertilizer': 3, 'sun': 13, 'water': 4},
        {'nutrient': 1, 'fertilizer': 10, 'sun': 17, 'heart': 30},
        {'nutrient': 5, 'fertilizer': 10, 'water': 35, 'sun': 30, 'heart': 50}
      ][level];
    }

    // 아이템 하나가 필요 개수만큼 정확히 줄었는지 (필요 없는 아이템은 그대로여야 함). 줄인 아이템은 0 이상으로 남아야 한다
    function itemDeductedBy(before, after, required, key) {
      let need = required.get(key, 0);
      return after.get(key, 0) == before.get(key, 0) - need &&
        (need == 0 || after.get(key, 0) >= 0);
    }

    // 성장 아이템 5종이 모두 조건 표대로 줄었는지 (box·gold는 레벨업과 무관해 확인하지 않음)
    function itemsDeductedForLevelUp(userId, required) {
      let before = get(userPath(userId)).data.get('item', {});
      let after = getAfter(userPath(userId)).data.get('item', {});
      return itemDeductedBy(before, after, required, 'heart') &&
        itemDeductedBy(before, after, required, 'sun') &&
        itemDeductedBy(before, after, required, 'water') &&
        itemDeductedBy(before, after, required, 'fertilizer') &&
        itemDeductedBy(before, after, required, 'nutrient');
    }

    // pots/{potId} 수정 중 레벨업: 레벨만 1 오르고, 학습 시간이 조건 이상이며, 같은 쓰기에서 아이템이 조건 표대로 줄어야 한다
    // 화분이 없으면 update 자체가 실패한다 (없는 화분)
    function potLeveledUp(userId) {
      let level = oldValue('potLevel', 0);
      return changedKeys().hasOnly(['potLevel']) &&
        level is int &&
        level >= 0 &&
        level < maxPotLevel() &&
        request.resource.data.potLevel == level + 1 &&
        oldValue('isCompleted', false) == false &&
        oldValue('potTotalStudyingTime', 0) >= levelUpMinStudyMs(level) &&
        itemsDeductedForLevelUp(userId, levelUpRequiredItems(level));
    }

    // users/{uid} 일반 쓰기(출석, 보너스 박스 개봉 등)는 성장 아이템을 줄일 수 없다 — 줄이는 것은 레벨업뿐이다
    // (늘리는 쓰기와 box·gold 검증은 #532에서 잠근다)
    function growthItemsNotDecreased() {
      let before = oldValue('item', {});
      let after = newValue('item', {});
      return after.get('heart', 0) >= before.get('heart', 0) &&
        after.get('sun', 0) >= before.get('sun', 0) &&
        after.get('water', 0) >= before.get('water', 0) &&
        after.get('fertilizer', 0) >= before.get('fertilizer', 0) &&
        after.get('nutrient', 0) >= before.get('nutrient', 0);
    }

    // users/{uid} 수정 중 레벨업: 같은 쓰기에서 표시한 화분의 레벨이 1 올라가야 한다 (차감량 검증은 potLeveledUp)
    // 표시 값이 이전과 같아도(같은 화분을 연속 레벨업) 화분 레벨 변화로 구분된다. 화분이 없으면 get이 실패해 거부된다
    function userLeveledUpPot(userId) {
      let potId = newValue('lastLevelUpPotId', '');
      return changedKeys().hasOnly(['item', 'lastLevelUpPotId']) &&
        isNonEmptyString(potId) &&
        getAfter(potPath(userId, potId)).data.get('potLevel', 0) ==
          get(potPath(userId, potId)).data.get('potLevel', 0) + 1;
    }

    match /users/{userId} {
      allow read: if isUid(userId);
      // 삭제 규칙 없음 = 거부: 회원탈퇴는 deleteAccount 함수(Admin SDK, 규칙 무관)가 처리한다 (#457)

      // 생성: 앱은 빈 닉네임으로 만든다 (createUser). 다른 사람 닉네임으로 만드는 것을 막는다
      // 학습 시간·완료 수는 0으로 시작하고, 학습 저장(#453)·완료/삭제 표시(#455)·레벨업 표시(#456) 필드는 해당 batch로만 생긴다
      allow create: if isUid(userId) &&
        (newValue('nickname', '') == '' || ownsNicknameAfterWrite(request.resource.data.nickname)) &&
        newValue('totalStudyTime', 0) == 0 &&
        newValue('completedPotsCount', 0) == 0 &&
        !request.resource.data.keys().hasAny([
          'lastStudyEndedAt', 'lastStudyPotId', 'lastStudySessionId',
          'lastCompletedPotId', 'lastDeletedPotId', 'lastDeletedLogId', 'lastLevelUpPotId'
        ]);

      // 수정: nickname을 바꾸지 않는 쓰기(이미지, 다크모드, gold, 출석, 아이템, 세션 토큰 등)는 닉네임 검사를 하지 않는다
      // 학습 시간·완료 수는 학습 기록 저장(#453), 화분 완료·기록 삭제·화분 삭제(#455) batch에서만 바꿀 수 있다
      // 성장 아이템(heart·sun·water·fertilizer·nutrient)을 줄이는 것은 화분 레벨업(#456) batch에서만 할 수 있다
      allow update: if isUid(userId) &&
        (!changedKeys().hasAny(['nickname']) || ownsNicknameAfterWrite(request.resource.data.get('nickname', null))) &&
        ((userCountedFieldsKept() && growthItemsNotDecreased()) ||
          userStudySaved(userId) ||
          userPotCompleted(userId) ||
          userStudyLogDeleted(userId) ||
          userPotDeleted(userId) ||
          userLeveledUpPot(userId));

      match /pots/{potsId} {
        allow read: if isUid(userId);

        // 삭제는 유저 학습 시간 차감과 같은 batch에서만 (#455). 하위 logs는 onPotDeleted 트리거가 지운다
        allow delete: if isUid(userId) && potDeletedWithTotals(userId, potsId);

        // 새 화분은 학습 시간 0, 레벨 0, 미완료로 시작한다 (앱의 PotDto는 lastStudiedAt·completedAt을 null로 함께 보낸다)
        allow create: if isUid(userId) &&
          newValue('potTotalStudyingTime', 0) == 0 &&
          newValue('potLevel', 0) == 0 &&
          newValue('lastStudiedAt', null) == null &&
          newValue('isCompleted', false) == false &&
          newValue('completedAt', null) == null &&
          !request.resource.data.keys().hasAny(['lastStudySessionId', 'lastDeletedLogId']);

        allow update: if isUid(userId) &&
          (potCountedFieldsKept() ||
            potStudySaved(userId, potsId) ||
            potCompleted(userId, potsId) ||
            potStudyLogDeleted(userId, potsId) ||
            potLeveledUp(userId));

        match /logs/{logsId} {
          allow read: if isUid(userId);
          // 기록 삭제는 화분·유저 학습 시간 차감과 같은 batch에서만 (#455). 보상 대기 중에 지워지면 트리거가 지급하지 않는다
          allow delete: if isUid(userId) && studyLogDeletedWithTotals(userId, potsId, logsId);
          allow create: if isUid(userId) && isValidNewStudyLog(userId, potsId, logsId);
          allow update: if isUid(userId) && onlyRewardSeenMarked();
        }
      }
    }

    // 홈의 "쌓인 보상" 조회: collectionGroup('logs')를 uid로 걸러 읽는다 (#453)
    // 읽기만 허용하고, 쓰기 규칙은 위 users/{userId}/pots/{potsId}/logs/{logsId} 한 곳에서만 관리한다
    // (규칙은 하나라도 허용하면 허용되므로 여기에 쓰기를 두면 위 검증이 우회됨)
    match /{path=**}/logs/{logId} {
      allow read: if signedIn() && resource.data.get('uid', '') == request.auth.uid;
    }

    match /posts/{postId} {
      function isPostAuthor() {
        return isUid(resource.data.author.id);
      }

      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.author.id == request.auth.uid &&
        hasInitialModeration() &&
        newValue('likeCount', 0) == 0 &&
        newValue('commentCount', 0) == 0 &&
        newValue('bookmarkCount', 0) == 0 &&
        newValue('likedBy', []).size() == 0 &&
        newValue('bookmarkedBy', []).size() == 0;

      allow update: if signedIn() && (
        // 작성자 수정: 본문 관련 필드만 (공유 게시글은 title/updatedAt만 보냄)
        (isPostAuthor() && changedKeys().hasOnly(['title', 'content', 'tag', 'updatedAt'])) ||
        // 좋아요: 본인 게시글에는 추가 불가, 해제는 허용 (예전 데이터 정리용)
        (selfToggled('likedBy', 'likeCount') && (!isPostAuthor() || selfRemoved('likedBy'))) ||
        selfToggled('bookmarkedBy', 'bookmarkCount') ||
        // commentCount는 앱이 쓰지 않는다 — 댓글 생성·삭제 트리거(functions/index.js, Admin SDK라 규칙 무관)가 세어 저장 (#528)
        // 신고: 작성자가 아닌 사용자가 신고 문서 생성과 함께 +1만 (#430 완료 후 클라이언트 쓰기 제거 예정)
        (!isPostAuthor() && onlyCountChangedBy('reportCount', 1) && reportCreatedInSameWrite(postId))
      );

      allow delete: if signedIn() && isPostAuthor();

      match /comments/{commentId} {
        function isCommentAuthor() {
          return isUid(resource.data.user.uid);
        }

        allow read: if signedIn();

        // 게시글이 있어야 한다 (#528): 예전에는 같은 batch의 commentCount +1이 없는 게시글에서 실패해
        // 삭제된 게시글에 댓글이 생기지 않았는데, 그 쓰기를 없애면서 규칙으로 막는다
        allow create: if signedIn() &&
          request.resource.data.user.uid == request.auth.uid &&
          hasInitialModeration() &&
          exists(/databases/$(database)/documents/posts/$(postId));

        // 회원탈퇴 시 댓글 익명화(content·user 변경)는 deleteAccount 함수가 처리한다 (#457)
        allow update: if signedIn() && (
          (isCommentAuthor() && changedKeys().hasOnly(['content'])) ||
          (!isCommentAuthor() && onlyCountChangedBy('reportCount', 1) && reportCreatedInSameWrite(commentId))
        );

        allow delete: if signedIn() && (
          isCommentAuthor() ||
          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.author.id
        );
      }

      // likes 하위 컬렉션(예전 좋아요 방식)은 규칙 없음 = 읽기·쓰기 모두 거부 (#457)
      // 좋아요는 likedBy 배열을 쓴다. 앱은 이 컬렉션을 읽지도 쓰지도 않으며, 탈퇴 시 남은 예전 문서는 deleteAccount 함수가 지운다
    }

    // collectionGroup("comments") 쿼리 허용
    // /{path=**} 와일드카드는 이 위치(최상위)에 있어야 동작함
    // 쓰기 규칙은 /posts/{postId}/comments/{commentId} 한 곳에서만 관리한다
    // (규칙은 하나라도 허용하면 허용되므로 여기에 쓰기를 두면 위 제한이 우회됨)
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn();
    }

    match /activities/{activityId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        (resource.data.targetId != '' &&
         request.auth.uid == get(/databases/$(database)/documents/posts/$(resource.data.targetId)).data.author.id)
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        (resource.data.targetId != '' &&
         request.auth.uid == get(/databases/$(database)/documents/posts/$(resource.data.targetId)).data.author.id)
      );
    }

    match /Tags/{document=**} {
      allow read: if request.auth != null;
    }

    // "공부 중" 표시 (#525) — 앱은 문서 전체를 set으로 쓰고(StudyingRemoteDataSourceImpl.saveStudyingUser)
    // updatedAt = serverTimestamp()를 함께 보낸다. 예약 함수(cleanUpStaleStudying)가 updatedAt이 오래된 문서를 지운다
    function validStudyingUser() {
      let data = request.resource.data;
      let fields = ['nickname', 'profileImg', 'tag', 'studyingTime', 'updatedAt'];
      return data.keys().hasAll(fields) &&
        data.keys().hasOnly(fields) &&
        data.nickname is string &&
        data.profileImg is string &&
        data.tag is string &&
        data.studyingTime is int &&
        data.studyingTime >= 0 &&
        data.updatedAt == request.time;
    }

    match /studying/{studyingId} {
      allow read: if signedIn();
      allow create, update: if isUid(studyingId) && validStudyingUser();
      allow delete: if isUid(studyingId);
    }

    // 문서 ID는 {신고자uid}_{대상id}로 고정 → 같은 대상 중복 신고는 같은 문서라 생성 불가
    // 수정/삭제 규칙 없음 = 거부 (운영진은 콘솔에서 처리)
    match /reports/{reportId} {
      // 중복 신고 확인은 아직 없는 문서를 조회하므로 resource == null 허용
      allow read: if signedIn() && (resource == null || resource.data.reporterId == request.auth.uid);
      allow create: if signedIn() &&
        reportId == request.auth.uid + '_' + request.resource.data.targetId &&
        request.resource.data.keys().hasOnly(['targetType', 'targetId', 'parentPostId', 'reporterId', 'reason', 'detail', 'createdAt', 'status']) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.targetType in ['post', 'comment'] &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
    }

    // 버그 제보·개선사항 제안: 본인 명의 생성만 허용
    // 읽기/수정/삭제 규칙 없음 = 거부 (운영진은 콘솔에서 처리)
    match /feedbacks/{feedbackId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['type', 'reporterId', 'category', 'description', 'reproductionSteps', 'deviceModel', 'androidVersion', 'appVersion', 'createdAt', 'status']) &&
        request.resource.data.keys().hasAll(['type', 'reporterId', 'category', 'description', 'appVersion', 'createdAt', 'status']) &&
        request.resource.data.reporterId == request.auth.uid &&
        (
          (request.resource.data.type == 'bug' && request.resource.data.category in ['ui_bug', 'feature_error', 'other']) ||
          (request.resource.data.type == 'improvement' && request.resource.data.category in ['ui_improvement', 'new_feature', 'convenience', 'other'])
        ) &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
    }

    // 닉네임 선점 문서: 소유자 uid를 함께 저장하고, 소유자만 삭제 가능
    // 삭제는 소유자이면서, 쓰기 후 내 users 문서가 없거나 users.nickname이 그 닉네임이 아닐 때만 허용 (nicknameReleasedAfterWrite, #549)
    // 이미 있는 문서에 set()하면 update로 평가되어 거부됨 (덮어쓰기 방지)
    // 없는 문서 삭제는 허용 (users와 nicknames가 어긋나도 닉네임 변경이 막히지 않게)
    // 회원탈퇴 시 닉네임 문서 삭제는 deleteAccount 함수가 처리한다 (#457)
    // 형식 검사(isValidNickname)는 생성에만 적용 — 규칙 이전에 만들어진 형식 위반 문서도 삭제는 같은 조건으로 허용
    match /nicknames/{nickname} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['nickname', 'uid']) &&
        request.resource.data.nickname == nickname &&
        isValidNickname(nickname) &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (
        resource == null ||
        (resource.data.get('uid', '') == request.auth.uid && nicknameReleasedAfterWrite(nickname))
      );
    }
  }
}
